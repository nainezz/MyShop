{
  "rules": {
    "products": {
      ".read": "auth != null",
      ".indexOn": ["creatorId"],
      "$productId": {
        ".write": "auth != null && (!data.exists() || data.child('creatorId').val() === auth.uid) && (!newData.exists() || newData.child('creatorId').val() === auth.uid)"
      }
    },
    "userFavorites": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "orders": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    }
  }
}
